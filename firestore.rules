rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Fonctions d'aide ───
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.email == 'yohannesende@gmail.com'
      );
    }

    // 1. Profils utilisateurs
    match /users/{userId} {
      allow read: if isSignedIn(); // l'admin doit pouvoir lister les utilisateurs
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin())
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid']);
    }

    // 2. Clients (stats admin)
    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }

    // 3. Messages & rapports
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 4. Devis
    match /devis/{devisId} {
      // Demande de devis : ouverte à tous (visiteur ou client connecté)
      allow create: if true;

      // Lecture : l'admin, ou le client à qui appartient le devis (Historique)
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Le client peut UNIQUEMENT confirmer un devis chiffré qui lui appartient :
      // statut "valide" → "client_valide", sans toucher au prix ni au reste.
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'valide'
        && request.resource.data.status == 'client_valide'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt'])
      );
    }

    // 5. Avis clients (page d'accueil)
    match /reviews/{reviewId} {
      // Visibles par tous les visiteurs du site
      allow read: if true;

      // Dépôt d'un avis : champs attendus uniquement, note de 1 à 5, textes de taille raisonnable
      allow create: if request.resource.data.keys().hasOnly(['name', 'comment', 'rating', 'photoUrl', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() > 0 && request.resource.data.comment.size() <= 2000
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
                    && request.resource.data.createdAt == request.time;

      // Modération (réponse, suppression) : admin uniquement
      allow update, delete: if isAdmin();
    }

    // 6. Système de mail
    match /mail/{mailId} {
      allow create: if isAdmin();
    }

    // 7. Règle de secours : tout le reste réservé à l'admin
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}